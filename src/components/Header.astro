---

---

<!-- Main Navigation Header -->
<header class="site-header">
  <div class="container">
    <div class="nav-wrapper">
      <!-- Logo -->
      <a
        href="/#bienvenido"
        class="brand brand-header"
        aria-label="Softlution Inicio"
      >
        <img
          src="/images/ASF-logo.png"
          alt="ASF Softlution Logo"
          class="brand-logo-img"
          width="50"
          height="50"
          loading="eager"
        />
        <span class="brand-title">Softlution!</span>
      </a>

      <!-- Desktop & Mobile Nav Menu (Mismos menús del sitio actual) -->
      <nav class="main-nav" id="main-nav" aria-label="Menú principal">
        <ul class="nav-links">
          <li class="nav-item">
            <a href="/#bienvenido" class="nav-link active">Inicio</a>
          </li>
          <li class="nav-item">
            <a href="/#quienes-somos" class="nav-link">Nosotros</a>
          </li>
          <li class="nav-item">
            <a href="/#servicios" class="nav-link">Servicios</a>
          </li>
          <li class="nav-item">
            <a href="/#nuestros-clientes" class="nav-link">Nuestros Clientes</a>
          </li>
          <li class="nav-item">
            <a href="/#demo" class="nav-link">Demo</a>
          </li>
        </ul>

        <div class="nav-actions">
          <a href="/#contacto" class="btn btn-primary">
            <span>Contactanos</span>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Mobile Drawer Quick Contacts -->
        <div class="mobile-drawer-contact">
          <div class="drawer-contact-title">Atención Inmediata</div>
          <a href="tel:5553782110" class="drawer-contact-item">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            <span>Tel: (55) 5378-2110</span>
          </a>
          <a
            href="mailto:contacto@softlution.com.mx"
            class="drawer-contact-item"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>contacto@softlution.com.mx</span>
          </a>
        </div>
      </nav>

      <!-- Mobile Drawer Toggle with Animated Hamburger -->
      <button
        class="mobile-toggle"
        aria-label="Abrir navegación móvil"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="mobile-toggle-box">
          <span class="mobile-toggle-line"></span>
          <span class="mobile-toggle-line"></span>
          <span class="mobile-toggle-line"></span>
        </span>
      </button>
    </div>
  </div>
</header>
