---
<!-- Metrics Ticker Strip -->
<div class="stats-strip">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-number" data-target="20" data-prefix="+" data-suffix="">+20</div>
        <div class="stat-label">Años de Trayectoria</div>
        <div class="stat-sub">Fundada en marzo de 2002</div>
      </div>
      <div class="stat-item">
        <div class="stat-item-inner">
          <div class="stat-number" data-target="100" data-prefix="+" data-suffix="">+100</div>
          <div class="stat-label">Proyectos Industriales</div>
          <div class="stat-sub">Empresas multinacionales</div>
        </div>
      </div>
      <div class="stat-item">
        <div class="stat-number" data-target="99.8" data-prefix="" data-suffix="%" data-decimals="1">
          99.8<span>%</span></div>
        <div class="stat-label">Confiabilidad Operativa</div>
        <div class="stat-sub">Cero paros no programados</div>
      </div>
      <div class="stat-item">
        <div class="stat-number" data-target="100" data-prefix="" data-suffix="%">100<span>%</span></div>
        <div class="stat-label">Normativas & Calidad</div>
        <div class="stat-sub">NOM, NEC, NEMA, CSIA</div>
      </div>
    </div>
  </div>
</div>
