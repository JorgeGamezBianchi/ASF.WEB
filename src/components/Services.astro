---
---
<!-- ==========================================================================
     SECTION 3: SERVICIOS (Services & Solutions)
     ========================================================================== -->
<section class="services-section" id="servicios">
  <div class="container">
    <div class="section-header">
      <div class="section-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
        Portafolio Especializado
      </div>
      <h2 class="section-title">Soluciones Integrales de Automatización e Información Industrial</h2>
      <p class="section-subtitle">
        Nuestra experiencia garantiza que la tecnología trabaje a favor de su rentabilidad, desde el concepto hasta
        la puesta en marcha.
      </p>
    </div>

    <!-- Filter tabs -->
    <div class="service-tabs">
      <button class="tab-btn active" data-category="all">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        Todos los Servicios
      </button>
      <button class="tab-btn" data-category="auto">Automatización & PLC</button>
      <button class="tab-btn" data-category="scada">SCADA & HMI</button>
      <button class="tab-btn" data-category="data">Productividad & Datos</button>
      <button class="tab-btn" data-category="elec">Ingeniería Eléctrica</button>
      <button class="tab-btn" data-category="turnkey">Llave en Mano</button>
    </div>

    <div class="services-grid">
      <!-- Service 1: Automatización de Procesos -->
      <div class="service-card" data-category="auto">
        <div class="service-icon-box">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
            <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
            <line x1="6" y1="6" x2="6.01" y2="6"></line>
            <line x1="6" y1="18" x2="6.01" y2="18"></line>
          </svg>
        </div>
        <h3 class="service-card-title">Automatización de Procesos & PLC's</h3>
        <p class="service-card-desc">
          Programación y comisionamiento de controladores lógicos programables de alto rendimiento. Especialistas en
          arquitecturas Rockwell Automation (ControlLogix, CompactLogix, SLC500, PLC-5) y Siemens.
        </p>
        <ul class="service-feature-list">
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Variadores de Frecuencia (VFD) y Arrancadores
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Centros de Control de Motores (CCM) inteligentes
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Redes Industriales: EtherNet/IP, Profinet, Modbus
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Sensores, instrumentación de campo y seguridad
          </li>
        </ul>
      </div>

      <!-- Service 2: SCADA & HMI -->
      <div class="service-card" data-category="scada">
        <div class="service-icon-box">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <h3 class="service-card-title">Interfaces de Operación (HMI & SCADA)</h3>
        <p class="service-card-desc">
          Desarrollo de pantallas gráficas intuitivas para la supervisión y control de planta en tiempo real.
          Reduzca errores humanos con interfaces modernas y alarmas de alta prioridad.
        </p>
        <ul class="service-feature-list">
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Supervisión centralizada cliente/servidor
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Wonderware InTouch / AVEVA System Platform
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Rockwell FactoryTalk View SE / ME
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Historizadores de datos y reportes automáticos
          </li>
        </ul>
      </div>

      <!-- Service 3: Productividad y Lotes -->
      <div class="service-card" data-category="data">
        <div class="service-icon-box">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
        </div>
        <h3 class="service-card-title">Sistemas de Productividad & Datos</h3>
        <p class="service-card-desc">
          Soluciones informáticas de planta para entregar datos en tiempo real sobre el desempeño de sus procesos,
          ruteo automático, bacheo y control de rendimientos.
        </p>
        <ul class="service-feature-list">
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Producción por lotes (Batch Control ISA-88)
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Validación y descarga de sistemas CIP (Clean-in-Place)
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Sistemas de Ruteo y Extrusión industrial
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Reportes de consumo de materias primas y energía
          </li>
        </ul>
      </div>

      <!-- Service 4: Ingeniería Eléctrica -->
      <div class="service-card" data-category="elec">
        <div class="service-icon-box">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3 class="service-card-title">Ingeniería Eléctrica & Tableros</h3>
        <p class="service-card-desc">
          Diseño, ensamble e integración de tableros de control y fuerza en baja y media tensión, cumpliendo
          rigurosamente las normas nacionales e internacionales aplicables.
        </p>
        <ul class="service-feature-list">
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Diseño de gabinetes y planos en AutoCAD Electrical
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Armado de tableros bajo normas NOM, NEC y NEMA
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Instalaciones eléctricas industriales en baja tensión
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Estudios de carga y tierras físicas industriales
          </li>
        </ul>
      </div>

      <!-- Service 5: Proyectos Llave en Mano -->
      <div class="service-card" data-category="turnkey">
        <div class="service-icon-box">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path
              d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
            </path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <h3 class="service-card-title">Proyectos Llave en Mano (Turnkey)</h3>
        <p class="service-card-desc">
          Gestión integral de proyectos desde el levantamiento conceptual, ingeniería básica y de detalle, procura
          de equipos, ensamble, pruebas en taller y puesta en servicio.
        </p>
        <ul class="service-feature-list">
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Administración integral y gestión de riesgos
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Pruebas de aceptación en fábrica (FAT) y sitio (SAT)
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Arranque, comisionamiento y calibración
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Capacitación a operadores y manuales de planta
          </li>
        </ul>
      </div>

      <!-- Service 6: Soporte y Mantenimiento -->
      <div class="service-card" data-category="auto scada">
        <div class="service-icon-box">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path
              d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z">
            </path>
          </svg>
        </div>
        <h3 class="service-card-title">Soporte Técnico & Modernización</h3>
        <p class="service-card-desc">
          Migración de plataformas obsoletas (PLC-5 a ControlLogix, SLC500 a CompactLogix), pólizas de soporte 24/7,
          respaldo de programas y optimización de secuencias de control.
        </p>
        <ul class="service-feature-list">
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Migración de sistemas legados sin paros prolongados
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Diagnóstico de fallas en redes de comunicación
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Pólizas de mantenimiento preventivo y correctivo
          </li>
          <li class="service-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Asistencia remota segura y guardia presencial
          </li>
        </ul>
      </div>
    </div>

    <!-- Integrators & Certifications Bar -->
    <div class="integrators-bar">
      <div class="integrators-title">Integradores Autorizados & Alianzas Estratégicas</div>
      <div class="integrators-grid">
        <div class="integrator-item">
          <div class="integrator-name">Rockwell Automation</div>
          <div class="integrator-tag">Allen-Bradley Systems</div>
        </div>
        <div class="integrator-item">
          <div class="integrator-name">Schneider Electric</div>
          <div class="integrator-tag">Industrial Automation</div>
        </div>
        <div class="integrator-item">
          <div class="integrator-name">CSIA Member</div>
          <div class="integrator-tag">System Integrators Assc.</div>
        </div>
        <div class="integrator-item">
          <div class="integrator-name">Wonderware / AVEVA</div>
          <div class="integrator-tag">SCADA & Data Software</div>
        </div>
        <div class="integrator-item">
          <div class="integrator-name">Danfoss</div>
          <div class="integrator-tag">Drives & Motor Controls</div>
        </div>
      </div>
    </div>
  </div>
</section>
