---
---
<!-- ==========================================================================
     SECTION 1: INICIO (Hero / Intro)
     ========================================================================== -->
<section class="hero" id="bienvenido">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="hero-badge-indicator"></span>
          <span class="hero-badge-text">Automatización Industrial & Control de Procesos • Desde 2002</span>
        </div>
        <h1 class="hero-title">
          Transformamos la operación de su industria con <span class="gradient-text">tecnología, control y máxima
            eficiencia</span>
        </h1>
        <p class="hero-desc">
          En <strong>ASF Softlution!</strong> diseñamos, integramos y comisionamos
          sistemas avanzados de automatización de procesos, arquitecturas SCADA/HMI, control de potencia e
          información en tiempo real para optimizar el rendimiento y la rentabilidad de las industrias más
          exigentes.
        </p>
        <div class="hero-actions">
          <a href="#servicios" class="btn btn-glow">
            <span>Explorar Soluciones</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="#demo" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Ver Demo en Vivo</span>
          </a>
        </div>

        <!-- Integrators strip in Hero -->
        <div class="hero-partners-strip">
          <div class="hero-partners-label">Integradores y Tecnologías Certificadas:</div>
          <div class="partners-logos">
            <div class="partner-logo-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                <path d="M2 17l10 5 10-5"></path>
                <path d="M2 12l10 5 10-5"></path>
              </svg>
              <span>Rockwell Automation (Allen-Bradley)</span>
            </div>
            <div class="partner-logo-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span>Schneider Electric</span>
            </div>
            <div class="partner-logo-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>CSIA Member</span>
            </div>
            <div class="partner-logo-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
              </svg>
              <span>AVEVA / Wonderware</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Hero Visual: Real-Time SCADA Telemetry Preview -->
      <div class="hero-visual">
        <div class="hero-float-card hero-float-card-1">
          <div class="float-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div class="float-data">
            <strong>+24% ROI</strong>
            <span>Eficiencia Operativa Promedio</span>
          </div>
        </div>

        <div class="hero-float-card hero-float-card-2">
          <div class="float-icon green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div class="float-data">
            <strong>0 Tiempos Muertos</strong>
            <span>Diagnósticos Preventivos SCADA</span>
          </div>
        </div>

        <div class="scada-panel">
          <div class="scada-header">
            <div class="scada-title-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                <line x1="6" y1="6" x2="6.01" y2="6"></line>
                <line x1="6" y1="18" x2="6.01" y2="18"></line>
              </svg>
              <span class="scada-title">ControlLogix PLC — Línea Principal #01</span>
            </div>
            <span class="scada-live-indicator">
              <span class="status-dot"></span> EN LÍNEA
            </span>
          </div>

          <div class="scada-grid">
            <div class="scada-gauge-card">
              <div class="gauge-label">
                <span>Dosificación Bacheo</span>
                <span style="color: var(--accent-cyan);">RUNNING</span>
              </div>
              <div class="gauge-val">94.8 <small>%</small></div>
              <div class="progress-bar-wrap">
                <div class="progress-bar-fill" style="width: 94%;"></div>
              </div>
            </div>

            <div class="scada-gauge-card">
              <div class="gauge-label">
                <span>Presión Red Hidráulica</span>
                <span style="color: var(--accent-emerald);">NORMAL</span>
              </div>
              <div class="gauge-val">4.2 <small>bar</small></div>
              <div class="progress-bar-wrap">
                <div class="progress-bar-fill"
                  style="width: 70%; background: linear-gradient(90deg, #10b981, #06b6d4);"></div>
              </div>
            </div>

            <div class="scada-gauge-card">
              <div class="gauge-label">
                <span>Flujo Recirculación CIP</span>
                <span style="color: var(--primary-light);">STABLE</span>
              </div>
              <div class="gauge-val">128.5 <small>L/min</small></div>
              <div class="progress-bar-wrap">
                <div class="progress-bar-fill" style="width: 82%;"></div>
              </div>
            </div>

            <div class="scada-gauge-card">
              <div class="gauge-label">
                <span>Eficiencia OEE Global</span>
                <span style="color: var(--accent-emerald);">+3.4%</span>
              </div>
              <div class="gauge-val">89.2 <small>%</small></div>
              <div class="progress-bar-wrap">
                <div class="progress-bar-fill"
                  style="width: 89%; background: linear-gradient(90deg, #38bdf8, #10b981);"></div>
              </div>
            </div>
          </div>

          <div class="scada-flow-preview">
            <div class="flow-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
              <span>Secuencia de Bacheo & Lavado CIP Automatizado</span>
            </div>
            <div class="flow-nodes">
              <div class="flow-line">
                <div class="flow-pulse"></div>
              </div>
              <div class="flow-node active">Materia Prima</div>
              <div class="flow-node active">Reactor 01</div>
              <div class="flow-node active">CIP Sanitizado</div>
              <div class="flow-node">Envasado</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
