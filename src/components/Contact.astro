---
---

<!-- ==========================================================================
     SECTION 6: CONTACTO
     ========================================================================== -->
<section class="contact-section" id="contacto">
  <div class="container">
    <div class="section-header">
      <div class="section-pill">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
          ></path>
        </svg>
        Canales de Atención
      </div>
      <h2 class="section-title">
        Contáctenos para iniciar su proyecto
      </h2>
      <p class="section-subtitle">
        Nuestro equipo de ingeniería profesional está a su disposición para
        asesorarlo en nuevos requerimientos y optimizar sus procesos industriales.
      </p>
    </div>

    <div class="contact-layout">
      <!-- Left Column: Contact Channels & Corporate Address -->
      <div class="contact-info-col">
        <div class="contact-card-box">
          <h3 class="contact-card-title">ASF Softlution!</h3>
          <p class="contact-card-desc">
            Puede comunicarse con nosotros a través de correo electrónico, vía
            telefónica, fax o programar una reunión en nuestras oficinas.
          </p>

          <div class="contact-channels">
            <!-- Dirección -->
            <div class="channel-item">
              <div class="channel-icon">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="channel-details">
                <span class="channel-title">Dirección de Oficinas</span>
                <span class="channel-value" style="font-size: 0.95rem;"
                  >H. Ayuntamiento No. 4-A, Col. San Juan Xocotla, Tultepec,
                  Edo. México, C.P. 54960</span
                >
                <span class="channel-sub">Tultepec, Estado de México</span>
              </div>
            </div>

            <!-- Teléfono -->
            <div class="channel-item">
              <div class="channel-icon">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  >
                  </path>
                </svg>
              </div>
              <div class="channel-details">
                <span class="channel-title">Teléfono</span>
                <span class="channel-value"
                  ><a href="tel:5553782110">(55) 5378-2110</a></span
                >
                <span class="channel-sub"
                  >Lunes a Viernes de 8:30 a 18:00 hrs</span
                >
              </div>
            </div>

            <!-- Fax -->
            <div class="channel-item">
              <div class="channel-icon">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 6 2 18 2 18 9"></polyline>
                  <path
                    d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
                  ></path>
                  <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
              </div>
              <div class="channel-details">
                <span class="channel-title">Fax</span>
                <span class="channel-value"
                  ><a href="tel:5553782110">(55) 5378-2105</a></span
                >
                <span class="channel-sub">Recepción de documentos continua</span>
              </div>
            </div>

            <!-- Correo de Contacto -->
            <div class="channel-item">
              <div class="channel-icon">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="channel-details">
                <span class="channel-title">Correo de Contacto</span>
                <span class="channel-value"
                  ><a href="mailto:contacto@softlution.com.mx"
                    >contacto@softlution.com.mx</a
                  ></span
                >
                <span class="channel-sub"
                  >Atención general y cotizaciones de ingeniería</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Map Card with Interactive Location -->
        <div class="contact-map-card">
          <div
            style="font-size: 0.85rem; font-weight: 700; color: #fff; margin-bottom: 0.6rem; display: flex; align-items: center; justify-content: space-between;"
          >
            <span>Ubicación en Tultepec</span>
            <span style="font-size: 0.72rem; color: var(--accent-cyan);"
              >Tultepec, Edo. Méx</span
            >
          </div>
          <div class="map-embed-wrapper">
            <iframe
              title="Ubicación Softlution Tultepec"
              src="https://maps.google.com/maps?q=H.+Ayuntamiento+No.+4,+Col.+San+Juan+Xocotla,+Tultepec,+Edo.+M%C3%A9xico+54960&t=&z=14&ie=UTF8&iwloc=&output=embed"
              loading="lazy"
            >
            </iframe>
          </div>
        </div>
      </div>

      <!-- Right Column: Unified Contact Form -->
      <div class="contact-form-box">
        <div class="form-header-box">
          <h3 class="form-title">Envíenos un Mensaje</h3>
          <p class="form-subtitle">
            Complete el formulario a continuación y un ingeniero especialista de Softlution!
            se comunicará con usted a la brevedad.
          </p>
        </div>

        <!-- Single Clean Contact Form -->
        <form id="form-contacto" class="contact-form">
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="contacto-nombre"
                >Tu nombre <span class="req">(*)</span></label
              >
              <div class="input-wrapper">
                <svg
                  class="input-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <input
                  type="text"
                  id="contacto-nombre"
                  class="form-control"
                  placeholder="Ej. Ing. Carlos Mendoza"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="contacto-email"
                >Tu correo electrónico <span class="req">(*)</span></label
              >
              <div class="input-wrapper">
                <svg
                  class="input-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input
                  type="email"
                  id="contacto-email"
                  class="form-control"
                  placeholder="nombre@empresa.com"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="contacto-telefono">Teléfono</label>
              <div class="input-wrapper">
                <svg
                  class="input-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  >
                  </path>
                </svg>
                <input
                  type="tel"
                  id="contacto-telefono"
                  class="form-control"
                  placeholder="10 dígitos"
                />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="contacto-empresa"
                >Empresa / Planta</label
              >
              <div class="input-wrapper">
                <svg
                  class="input-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <input
                  type="text"
                  id="contacto-empresa"
                  class="form-control"
                  placeholder="Nombre de su planta o empresa"
                />
              </div>
            </div>

            <div class="form-group full-width">
              <label class="form-label" for="contacto-asunto"
                >Asunto del proyecto o consulta <span class="req">(*)</span></label
              >
              <input
                type="text"
                id="contacto-asunto"
                class="form-control"
                style="padding-left: 1rem;"
                placeholder="Ej. Automatización de línea / Migración PLC / Cotización"
                required
              />
            </div>

            <div class="form-group full-width">
              <label class="form-label" for="contacto-mensaje"
                >Tu mensaje y descripción técnica <span class="req">(*)</span></label
              >
              <textarea
                id="contacto-mensaje"
                class="form-control"
                placeholder="Detalle las necesidades de su planta, alcance deseado, marcas de preferencia o requerimientos específicos..."
                required></textarea>
              <span class="form-hint"
                >Su información y requerimientos permanecerán estrictamente confidenciales.</span
              >
            </div>
          </div>

          <div class="form-submit-row">
            <span style="font-size: 0.8rem; color: var(--text-muted);">
              Los campos con <span style="color: var(--accent-cyan);">(*)</span> son
              obligatorios.
            </span>
            <button type="submit" class="btn btn-primary">
              <span>Enviar Mensaje</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
